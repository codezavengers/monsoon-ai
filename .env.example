# Port for the Node.js / Express development server
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Monsoon forecasting mode: 'DEMO' (benchmark dataset) or 'REAL' (operational feed)
MODE=DEMO

# Disable Vite HMR in AI Studio container environment
DISABLE_HMR=true

# Google Gemini API key for server-side meteorological synoptic reasoning
GEMINI_API_KEY=
